# ==========================================
# GlobeTrotter AI - Environment Configuration Example
# ==========================================

# Application Settings
APP_NAME=GlobeTrotter AI
APP_ENV=development
DEBUG=True
PORT=8000
HOST=127.0.0.1

# NVIDIA NIM / LLM Configuration
# Sign up at https://build.nvidia.com to obtain your API key (starts with nvapi-)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Current Active NVIDIA NIM Models (Verified):
# - nvidia/nemotron-3.5-bolt-e4b (Default: Fast, High-Quality Nemotron Instruction Model)
# - google/gemma-4-31b-it (High Capacity Instruction Model)
# - mistralai/mistral-large-4-1t-a52b (High Capacity Reasoning Model)
NVIDIA_MODEL_NAME=nvidia/nemotron-3.5-bolt-e4b
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# Research & Search API Configuration
# Get your free API key at https://app.tavily.com (starts with tvly-)
# If not set, GlobeTrotter AI automatically falls back to Wikipedia & Wikidata REST APIs
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced

# Image Providers Configuration (Optional)
# Wikimedia Commons is the primary built-in free image repository (requires NO key)
# Unsplash: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
# Pexels: https://www.pexels.com/api/
PEXELS_API_KEY=

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/globetrotter_ai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=False

# Production Limits (Gradual Scaling)
DAILY_ARTICLE_LIMIT=set a number 
DEFAULT_QUALITY_THRESHOLD=8.0

# Admin Portal Authentication (Change these values anytime in .env)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET_KEY=globetrotter-super-secret-admin-key-2026
